# Copy to .env for local development. .env is gitignored.
NODE_ENV=development
SESSIONS_SECRET=testing
# JWT signing secrets for API/mobile clients (POST /tokens). Optional in
# dev/test, where each falls back to SESSIONS_SECRET; set distinct values in
# production. Access tokens live 15 minutes, refresh tokens 30 days (rotated).
JWT_ACCESS_SECRET=testing-access
JWT_REFRESH_SECRET=testing-refresh

PGUSER=bugtracker_backend_database_user
PGPASSWORD=testing
PGHOST=localhost
# Must match the host port Postgres is published on. If 5432 is already taken on
# your machine, start compose with PG_HOST_PORT=55432 and set PGPORT=55432 here.
PGPORT=5432
PGDATABASE=bugtracker_backend_database

REDIS_HOST=localhost
REDIS_PORT=6379
