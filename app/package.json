{
  "name": "bugtracker-api",
  "version": "2.0.0",
  "description": "This is the express backend for the bugtracker I'm building.",
  "main": "index.js",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "tsx watch ./src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "testw": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "testd": "NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx ./src/db/migrate.ts",
    "bench": "NODE_ENV=test DOTENV_CONFIG_QUIET=true tsx ./scripts/bench.ts",
    "ddev": "docker compose up --remove-orphans api redis postgres",
    "dddev": "docker compose up --remove-orphans -d postgres redis",
    "pgadmin": "docker compose up --remove-orphans",
    "ddown": "docker compose down",
    "dbuild": "docker build -t cstudent/express-backend .",
    "drun": "docker run --rm -p 3000:3000 --env-file .env cstudent/express-backend",
    "dshell": "docker run --rm -it --env-file .env cstudent/express-backend /bin/bash",
    "dkill": "docker stop $(docker ps -a -q)",
    "dclear": "docker rm $(docker ps -a -q)",
    "dpsql": "docker exec -it postgres_container psql -U bugtracker_backend_database_user -d bugtracker_backend_database"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "connect-redis": "^10.0.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/autocannon": "^7.12.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "autocannon": "^8.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "node-mocks-http": "^1.18.1",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
