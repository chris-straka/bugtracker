{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "build",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    // TS 7 no longer auto-includes every @types package as globals the way
    // TS 5 did; name the globals this project needs explicitly.
    "types": ["node", "jest"],
    "isolatedModules": true,
    "experimentalDecorators": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"]
}
